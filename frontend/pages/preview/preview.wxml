<view class="page">
  <view class="topbar"><view class="brand"><view class="brand-mark">上</view><text>核对与导出</text></view><view class="capsule">第 3 步</view></view>
  <view class="stepper"><view class="step done"><view class="step-dot">✓</view><text>产品资料</text></view><view class="step done"><view class="step-dot">✓</view><text>生成方案</text></view><view class="step active"><view class="step-dot">3</view><text>核对导出</text></view></view>
  <view class="status-line"><view><view class="section-title">{{loading ? '正在制作产品套图' : '产品素材已准备好'}}</view><view class="muted">{{loading ? '正在排版与导出 PNG，请稍候' : '先核对信息与产品细节，再保存发布'}}</view></view><view class="ready-badge">{{loading ? '处理中' : '✓ 已完成'}}</view></view>
  <view class="notice">{{aiMode === 'scene' ? 'AI 已重构背景和光影，请重点核对型号、接口、形状、颜色、数量、铭牌文字与 Logo。' : (aiProcessed ? 'AI 已移除原背景，请重点核对产品边缘、颜色、接口、数量与 Logo。' : '当前保留完整原图，原片背景不会移除。')}}</view>
  <view class="review-card card">
    <view class="review-head"><view><view class="section-title">发布前信息核对</view><view class="muted">以下内容来自你的录入，不代表系统已验证</view></view><view class="review-badge">待人工核对</view></view>
    <view class="review-row"><text>产品名称 / 型号</text><text>{{summary.name || '未填写'}}</text></view>
    <view wx:if="{{summary.brandName}}" class="review-row"><text>企业 / 品牌</text><text>{{summary.brandName}}</text></view>
    <view class="review-row"><text>参考报价</text><text>{{summary.price ? '¥ ' + summary.price : '欢迎咨询'}}</text></view>
    <view class="review-specs"><text class="review-label">关键参数 / 卖点</text><view wx:if="{{summary.features.length}}" class="review-chips"><text wx:for="{{summary.features}}" wx:key="index">{{item}}</text></view><text wx:else class="review-empty">未填写，请确认是否需要返回补充</text></view>
  </view>
  <view wx:if="{{aiProcessed && processedPath}}" class="compare-card card">
    <view class="compare-head"><view><view class="section-title">产品处理对比</view><view class="muted">先核对 AI 结果，再检查成片</view></view><view class="ai-badge">{{aiMode === 'scene' ? 'AI 场景' : 'AI 抠图'}}</view></view>
    <view class="compare-tabs"><view class="{{compareMode === 'original' ? 'active' : ''}}" data-mode="original" bindtap="compare">原始照片</view><view class="{{compareMode === 'processed' ? 'active' : ''}}" data-mode="processed" bindtap="compare">{{aiMode === 'scene' ? 'AI 场景图' : '透明主体'}}</view></view>
    <view class="checker {{aiMode === 'scene' ? 'scene-result' : ''}}"><image src="{{compareMode === 'original' ? originalPath : processedPath}}" mode="aspectFit"/></view>
  </view>
  <view wx:if="{{error}}" class="card error-card"><view class="section-title">制作没有完成</view><view class="muted">{{error}}</view><button class="secondary-btn" bindtap="render">重新制作</button><button class="text-btn" bindtap="edit">返回修改商品</button></view>
  <view wx:if="{{loading}}" class="preview-skeleton"><view class="spinner"></view><text>正在生成第 1～3 张图片</text></view>
  <view wx:if="{{currentPath}}" class="result-card"><image class="result" src="{{currentPath}}" mode="widthFix"/><view class="result-label">{{variants[selected]}}</view></view>
  <view class="section-label"><view class="section-title">素材选择</view><view class="muted">共 3 张</view></view>
  <scroll-view class="thumbs" scroll-x><view class="thumb {{selected === index ? 'active' : ''}}" wx:for="{{variants}}" wx:key="index" data-index="{{index}}" bindtap="select"><view class="thumb-number">0{{index + 1}}</view><text>{{item}}</text><text class="thumb-help">{{index === 1 ? '展示关键规格与卖点' : (index === 2 ? '用于渠道发布与询价' : '用于目录或产品上架')}}</text></view></scroll-view>
  <view class="bottom-action"><view class="triple-actions"><button class="collect-btn" disabled="{{loading || collecting || collected || outputs.length !== 3}}" loading="{{collecting}}" bindtap="collect">{{collected ? '✓ 已收藏' : '收藏整套'}}</button><button class="single-btn" disabled="{{loading || saving || savingAll || !currentPath}}" loading="{{saving}}" bindtap="save">保存当前</button><button class="primary" disabled="{{loading || saving || savingAll || outputs.length !== 3}}" loading="{{savingAll}}" bindtap="saveAll">{{saveProgress || '保存三张'}}</button></view><view class="bottom-links"><text bindtap="edit">修改产品信息</text><text bindtap="restart">制作新产品</text></view><button wx:if="{{permissionDenied}}" class="permission" bindtap="openSettings">打开相册权限设置</button></view>
  <canvas type="2d" id="poster" class="export-canvas"></canvas>
</view>
