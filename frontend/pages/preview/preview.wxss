.status-line,.section-label{display:flex;align-items:center;justify-content:space-between}.status-line{margin:28rpx 2rpx 22rpx}.ready-badge{padding:10rpx 15rpx;border-radius:12rpx;background:#dcfae9;color:#006947;font-size:21rpx;font-weight:700}.profile-check{margin-bottom:20rpx;padding:24rpx;background:linear-gradient(145deg,#fff,#f8f9ff)}.profile-check-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.profile-check-label{margin-bottom:6rpx;color:#667085;font-size:20rpx}.profile-check-name{font-size:29rpx;font-weight:800}.verified-badge{padding:8rpx 12rpx;border-radius:12rpx;background:#fff0e9;color:#9a3300;font-size:18rpx;font-weight:700}.profile-check-model{margin-top:14rpx;color:#313b4d;font-size:24rpx;font-weight:700}.profile-check-meta{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:12rpx}.profile-check-meta text{padding:7rpx 12rpx;border-radius:999rpx;background:#eef2ff;color:#596273;font-size:19rpx}.profile-check-note{margin-top:16rpx;padding-top:16rpx;border-top:1rpx solid #e5e7ef;color:#7f2b00;font-size:20rpx;line-height:1.5}.notice{margin-bottom:22rpx}.result-card{position:relative;padding:16rpx;background:#fff;border-radius:28rpx;box-shadow:0 14rpx 40rpx rgba(38,49,67,.1)}.result{display:block;width:100%;border-radius:20rpx}.result-label{position:absolute;left:30rpx;top:30rpx;padding:9rpx 15rpx;border-radius:10rpx;background:rgba(38,49,67,.84);color:#fff;font-size:20rpx}.preview-skeleton{height:620rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24rpx;border-radius:28rpx;background:linear-gradient(135deg,#f0f3ff,#fff0e9);color:#667085;font-size:25rpx}.spinner{width:58rpx;height:58rpx;border:7rpx solid #ffdbce;border-top-color:#a33900;border-radius:50%;animation:spin .9s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.section-label{margin:34rpx 2rpx 18rpx}.thumbs{white-space:nowrap;margin-right:-28rpx;padding-bottom:12rpx}.thumb{display:inline-block;width:230rpx;margin-right:16rpx;padding:20rpx;box-sizing:border-box;border:3rpx solid transparent;border-radius:22rpx;background:#fff;vertical-align:top;box-shadow:0 8rpx 22rpx rgba(38,49,67,.05)}.thumb.active{border-color:#b53f00;background:#fff9f6}.thumb text,.thumb small{display:block}.thumb text{margin:11rpx 0 6rpx;font-size:25rpx;font-weight:700}.thumb small{color:#7a8290;font-size:19rpx}.thumb-number{color:#a33900;font-size:20rpx;font-weight:800}.bottom-links{display:flex;justify-content:center;gap:46rpx;margin-top:18rpx;color:#7f2b00;font-size:23rpx}.permission{margin-top:14rpx;background:#ffdbce;color:#7f2b00;font-size:24rpx}.error-card .muted{margin:14rpx 0 20rpx}.error-card button{margin-top:12rpx}.text-btn{background:transparent;color:#7f2b00;font-size:24rpx}.export-canvas{position:fixed;left:-2000px;top:0;width:360px;height:480px;pointer-events:none}
.thumb-help{margin:0!important;color:#7a8290!important;font-size:19rpx!important;font-weight:400!important}
.compare-card{margin-bottom:24rpx;padding:22rpx}.compare-head{display:flex;align-items:center;justify-content:space-between}.ai-badge{padding:8rpx 13rpx;border-radius:12rpx;background:#e5f8ef;color:#087451;font-size:19rpx;font-weight:700}.compare-tabs{display:grid;grid-template-columns:1fr 1fr;gap:10rpx;margin:20rpx 0 14rpx;padding:7rpx;border-radius:16rpx;background:#edf0f6}.compare-tabs view{text-align:center;padding:13rpx;border-radius:12rpx;color:#687083;font-size:22rpx}.compare-tabs .active{background:#fff;color:#8f3100;font-weight:700;box-shadow:0 4rpx 12rpx rgba(31,38,52,.08)}.checker{height:380rpx;border-radius:18rpx;overflow:hidden;background-color:#f7f7f7;background-image:linear-gradient(45deg,#e7e7e7 25%,transparent 25%),linear-gradient(-45deg,#e7e7e7 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#e7e7e7 75%),linear-gradient(-45deg,transparent 75%,#e7e7e7 75%);background-size:30rpx 30rpx;background-position:0 0,0 15rpx,15rpx -15rpx,-15rpx 0}.checker image{width:100%;height:100%}.triple-actions{display:grid;grid-template-columns:1fr 1fr;gap:12rpx}.collect-btn,.single-btn{width:100%;height:82rpx;line-height:82rpx;padding:0;border-radius:18rpx;font-size:22rpx;font-weight:700;white-space:nowrap;overflow:hidden}.collect-btn{background:#ffdbce;color:#7f2b00}.single-btn{background:#eef1f8;color:#313b4d}.collect-btn[disabled],.single-btn[disabled]{background:#eee;color:#999}.triple-actions .primary{grid-column:1/3;width:100%;height:88rpx;line-height:88rpx;padding:0;font-size:24rpx}.bottom-links{flex-wrap:wrap;row-gap:10rpx}
