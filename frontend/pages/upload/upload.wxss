.tip{margin-bottom:22rpx}.upload-card{box-sizing:border-box;width:100%;padding:24rpx}.card-heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:20rpx}.success-tag{padding:8rpx 13rpx;border-radius:10rpx;background:#ddfae9;color:#006947;font-size:20rpx}.uploader{box-sizing:border-box;width:100%;height:430rpx;position:relative;display:flex;align-items:center;justify-content:center;text-align:center;border:3rpx dashed #d7b5a8;border-radius:24rpx;background:#f6f2ed;overflow:hidden}.uploader.has-image{border-style:solid;background:#f0f3ff}.uploader image{width:100%;height:100%}.empty-upload{padding:30rpx}.plus{width:84rpx;height:84rpx;line-height:79rpx;margin:0 auto 18rpx;border-radius:24rpx;background:#fff;color:#a33900;font-size:52rpx;box-shadow:0 8rpx 24rpx rgba(38,49,67,.08)}.upload-title{font-size:28rpx;font-weight:700;margin-bottom:8rpx}.replace{position:absolute;right:16rpx;top:16rpx;padding:10rpx 16rpx;border-radius:999rpx;background:rgba(38,49,67,.82);color:#fff;font-size:21rpx}.counter{text-align:right;margin-top:8rpx;color:#9299a5;font-size:20rpx}.optional{margin-left:8rpx;color:#9299a5;font-size:21rpx;font-weight:400}.price-field{position:relative}.price-field>text{position:absolute;z-index:2;left:24rpx;top:24rpx;color:#a33900;font-weight:700}.price-field .input{padding-left:55rpx}.feature-input{display:grid;grid-template-columns:minmax(0,1fr) 118rpx;gap:14rpx;width:100%}.feature-input .input{min-width:0}.feature-input button{width:118rpx;height:88rpx;line-height:88rpx;padding:0;border-radius:18rpx;background:#ffdbce;color:#8b2e00;font-size:25rpx;font-weight:700}.chips{margin-top:16rpx}.helper{margin-top:12rpx;font-size:21rpx}
.brand-colors{display:flex;gap:16rpx;margin-top:18rpx}.brand-color{width:52rpx;height:52rpx;line-height:52rpx;text-align:center;border:5rpx solid #fff;border-radius:50%;box-shadow:0 0 0 2rpx #d4d8e0;color:#fff;font-size:22rpx;font-weight:800}.brand-color.active{box-shadow:0 0 0 5rpx #ffb591}
