<view class="page"><view class="topbar"><view class="brand"><view class="brand-mark">上</view><text>我的作品</text></view><view class="capsule">本机保存</view></view><view class="works-head"><view><view class="title">上新作品库</view><view class="muted">最多保留 6 套，仅保存在当前微信与设备中</view></view><button class="create-small" bindtap="create">＋ 新制作</button></view><view wx:if="{{!works.length}}" class="empty card"><view class="empty-icon">▧</view><view class="section-title">还没有收藏作品</view><view class="muted">制作完成后点击“收藏整套到作品库”</view><button class="primary" bindtap="create">制作第一套</button></view><view class="work-card card" wx:for="{{works}}" wx:key="id"><view class="gallery"><image wx:for="{{item.outputs}}" wx:for-item="output" wx:for-index="outputIndex" wx:key="*this" class="gallery-image {{outputIndex === 0 ? 'main' : ''}}" src="{{output}}" mode="aspectFill" data-id="{{item.id}}" data-index="{{outputIndex}}" bindtap="preview"/></view><view class="work-body"><view class="work-line"><view><view class="section-title">{{item.name}}</view><view class="muted">{{item.ratio}} · {{item.dateText}}</view></view><view class="price" wx:if="{{item.price}}">¥ {{item.price}}</view></view><view class="tags"><text wx:if="{{item.aiLabel}}">{{item.aiLabel}}</text><text>3 张套图</text><text wx:if="{{item.sourcePath}}" data-id="{{item.id}}" bindtap="reuse">再次编辑</text></view><view class="work-actions"><button class="save-all" data-id="{{item.id}}" loading="{{savingAllId === item.id}}" bindtap="saveAll">{{savingAllId === item.id ? saveProgress : '保存整套'}}</button><button class="secondary" data-id="{{item.id}}" loading="{{savingId === item.id}}" bindtap="saveMain">仅保存主图</button><button class="danger" data-id="{{item.id}}" bindtap="remove">删除作品</button></view></view></view><button wx:if="{{permissionDenied}}" class="permission" bindtap="openSettings">打开相册权限设置</button></view>
