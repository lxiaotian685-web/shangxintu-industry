.profile-card{margin-bottom:34rpx;background:linear-gradient(145deg,#fff,#fff8f4)}.profile-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.profile-eyebrow{margin-bottom:7rpx;color:#a33900;font-size:20rpx;font-weight:700}.profile-name{font-size:32rpx;font-weight:800;line-height:1.3}.profile-edit{width:104rpx;height:58rpx;line-height:58rpx;padding:0;border-radius:16rpx;background:#ffdbce;color:#8f3100;font-size:22rpx;font-weight:700}.profile-model{margin-top:16rpx;color:#313b4d;font-size:25rpx;font-weight:700}.profile-meta{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:14rpx}.profile-meta text{padding:8rpx 13rpx;border-radius:999rpx;background:#f0f3ff;color:#596273;font-size:20rpx}.profile-status{display:flex;align-items:center;gap:10rpx;margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid #eee2dc;color:#667085;font-size:21rpx}.status-dot{width:14rpx;height:14rpx;border-radius:50%;background:#0b8f64;box-shadow:0 0 0 6rpx rgba(11,143,100,.1)}.section-label{display:flex;align-items:flex-end;justify-content:space-between;margin:30rpx 2rpx 18rpx}.ratios{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.ratio-card{position:relative;display:flex;align-items:center;gap:14rpx;padding:20rpx;background:#fff;border:3rpx solid transparent;border-radius:22rpx;box-shadow:0 8rpx 24rpx rgba(38,49,67,.05)}.ratio-card.active{border-color:#b53f00;background:#fff9f6}.ratio-card text,.ratio-card small{display:block}.ratio-card text{font-size:25rpx;font-weight:700}.ratio-card small{margin-top:5rpx;color:#7a8290;font-size:18rpx}.ratio-shape{width:38rpx;background:#d8e3fb;border:3rpx solid #6b7280}.square{height:38rpx}.portrait{height:50rpx}.check{position:absolute;right:9rpx;top:8rpx;color:#b53f00;font-weight:800}.template-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.template{overflow:hidden;background:#fff;border:3rpx solid transparent;border-radius:24rpx;box-shadow:0 8rpx 24rpx rgba(38,49,67,.06)}.template.selected{border-color:#b53f00}.cover{height:250rpx;position:relative;background:linear-gradient(145deg,#d5a47d,#77412e)}.cover.clean{background:linear-gradient(145deg,#f7f8fb,#9aa4b2)}.cover.sale{background:linear-gradient(145deg,#f3a17c,#a62f12)}.mock-frame{position:absolute;inset:20rpx;background:rgba(255,255,255,.2);border:2rpx solid rgba(255,255,255,.45)}.mock-frame>text{position:absolute;left:12rpx;top:10rpx;color:#fff;font-size:18rpx;font-weight:800}.mock-cup{position:absolute;width:68rpx;height:78rpx;left:50%;top:50%;transform:translate(-50%,-35%);border-radius:8rpx 8rpx 24rpx 24rpx;background:#f5e1ca}.selected-badge{position:absolute;right:12rpx;top:12rpx;width:38rpx;height:38rpx;line-height:38rpx;text-align:center;border-radius:50%;background:#b53f00;color:#fff}.meta{padding:18rpx}.meta view{font-size:25rpx;font-weight:700}.meta text{display:block;margin-top:7rpx;color:#7a8290;font-size:19rpx;line-height:1.45}.notice{margin:26rpx 0 12rpx}.action-summary{margin-bottom:12rpx}.action-summary text,.action-summary small{display:block}.action-summary text{font-size:24rpx;font-weight:700}.action-summary small{margin-top:4rpx;color:#7a8290;font-size:19rpx}
.ratio-help{margin-top:5rpx!important;color:#7a8290!important;font-size:18rpx!important;font-weight:400!important}.action-help{margin-top:4rpx!important;color:#7a8290!important;font-size:19rpx!important;font-weight:400!important}
.processing-options{display:grid;gap:14rpx}.processing-card{position:relative;display:flex;align-items:center;gap:16rpx;padding:20rpx;background:#fff;border:3rpx solid transparent;border-radius:22rpx}.processing-card.active{border-color:#b53f00;background:#fff9f6}.processing-icon{width:62rpx;height:62rpx;line-height:62rpx;text-align:center;border-radius:18rpx;background:#b53f00;color:#fff;font-size:21rpx;font-weight:800}.processing-icon.plain{background:#e9edf5;color:#4d5666}.processing-card text{display:block;font-size:24rpx;font-weight:700}.processing-card .processing-help{margin-top:5rpx;color:#7a8290;font-size:19rpx;font-weight:400}
.processing-card.disabled{opacity:.58}.service-status{max-width:330rpx;text-align:right;color:#7a8290;font-size:18rpx}.service-status.online{color:#087451}.service-status.offline{color:#a43d18}
.scale-options{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.scale-item{padding:19rpx 10rpx;text-align:center;border:3rpx solid transparent;border-radius:18rpx;background:#fff;color:#5e6675;font-size:23rpx;font-weight:700}.scale-item.active{border-color:#b53f00;background:#fff9f6;color:#8f3100}
.position-grid{display:grid;grid-template-columns:repeat(3,58rpx);grid-template-rows:repeat(3,58rpx);gap:8rpx;width:190rpx;padding:14rpx;margin:0 auto;border-radius:20rpx;background:#fff;box-shadow:0 8rpx 22rpx rgba(38,49,67,.06)}.position-dot{display:flex;align-items:center;justify-content:center;border-radius:12rpx;background:#eef1f7}.position-dot text{width:15rpx;height:15rpx;border-radius:50%;background:#aab1bd}.position-dot.active{background:#ffdbce;box-shadow:inset 0 0 0 3rpx #b53f00}.position-dot.active text{background:#b53f00}
.processing-card.featured{padding-top:28rpx}.recommend{position:absolute;left:18rpx;top:-12rpx;padding:4rpx 12rpx;border-radius:999rpx;background:#ffdbce;color:#8f3100;font-size:17rpx;font-weight:800}.processing-icon.scene{background:linear-gradient(135deg,#b53f00,#6b46a2)}
.scene-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.scene-card{min-width:0;padding:12rpx;background:#fff;border:3rpx solid transparent;border-radius:20rpx}.scene-card.active{border-color:#b53f00;background:#fff9f6}.scene-swatch{height:92rpx;margin-bottom:10rpx;border-radius:14rpx;background:linear-gradient(145deg,#f8f4eb,#c8ad91)}.scene-lifestyle{background:linear-gradient(145deg,#f7d6a0,#8baa7d)}.scene-premium{background:linear-gradient(145deg,#5f6672,#17191e)}.scene-fresh{background:linear-gradient(145deg,#ffd6ca,#b9ddeb)}.scene-card text{display:block;font-size:22rpx;font-weight:700}.scene-card .scene-help{margin-top:4rpx;color:#7a8290;font-size:17rpx;font-weight:400;line-height:1.35}
.cover{background:linear-gradient(145deg,#f4dfca 0%,#c6875f 62%,#71351f 100%)}.cover.clean{background:linear-gradient(145deg,#fff 0%,#dce3eb 55%,#526074 100%)}.cover.sale{background:linear-gradient(145deg,#ffcf5a 0%,#e65d2d 38%,#741d07 100%)}.mock-frame{overflow:hidden;background:rgba(255,255,255,.18);border-color:rgba(255,255,255,.6);box-shadow:inset 0 -52rpx 0 rgba(65,31,18,.16)}.cover.clean .mock-frame{box-shadow:inset 48rpx 0 0 rgba(25,35,51,.72),inset 0 -48rpx 0 rgba(65,78,96,.14)}.cover.sale .mock-frame{box-shadow:inset -64rpx 0 0 rgba(97,22,4,.34),inset 0 -50rpx 0 rgba(91,21,4,.28)}.mock-cup{box-shadow:0 22rpx 18rpx rgba(44,25,17,.26)}
