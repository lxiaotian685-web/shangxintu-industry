.home{padding-top:34rpx}.hero{padding:22rpx 4rpx 10rpx}.eyebrow{display:inline-block;padding:9rpx 16rpx;margin-bottom:18rpx;border-radius:12rpx;background:#ffede5;color:#8b2e00;font-size:22rpx;font-weight:700}.title text{display:block;color:#b53f00}.intro{margin:22rpx 0 34rpx}.showcase{margin-top:30rpx}.showcase-head,.section-row{display:flex;align-items:center;justify-content:space-between}.showcase-head>view:first-child,.section-row>view:first-child{min-width:0}.mini-badge{flex:none;padding:9rpx 13rpx;border-radius:12rpx;background:#e8fff5;color:#006947;font-size:20rpx}.compare{display:flex;align-items:center;margin-top:24rpx}.photo{height:270rpx;flex:1;position:relative;overflow:hidden;border-radius:20rpx}.raw{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;background:linear-gradient(145deg,#e9edf3,#d8dfe8);color:#596579;font-size:22rpx}.photo-icon{font-size:54rpx}.photo-note{font-size:17rpx;color:#7b8492}.arrow{width:54rpx;text-align:center;color:#b53f00;font-weight:800}.polished{background:linear-gradient(145deg,#f2b887 0%,#a54417 55%,#4d1f12 100%)}.product-shape,.mock-product{position:absolute;width:92rpx;height:78rpx;left:55%;top:51%;transform:translate(-50%,-40%);border-radius:15rpx;background:linear-gradient(145deg,#d9e0e6,#77828e);border:5rpx solid #f2f4f6;box-shadow:inset -12rpx -8rpx rgba(27,36,46,.18),0 16rpx 24rpx rgba(24,20,18,.25)}.product-shape::before,.mock-product::before{content:"";position:absolute;width:42rpx;height:42rpx;left:20rpx;top:13rpx;border:8rpx solid #283440;border-radius:50%;background:#a9d8e8;box-shadow:inset 0 0 0 7rpx #3c5967}.product-shape::after,.mock-product::after{content:"";position:absolute;right:-34rpx;top:30rpx;width:38rpx;height:10rpx;border-radius:0 10rpx 10rpx 0;background:#293541}.poster-copy{position:absolute;z-index:2;left:14rpx;top:14rpx;color:#fff}.poster-copy text{display:block}.poster-copy text:first-child{font-size:14rpx;letter-spacing:1rpx}.poster-copy .strong{font-size:22rpx;font-weight:700}.poster-copy .small{margin-top:126rpx;padding:5rpx 8rpx;background:rgba(255,255,255,.93);color:#71351f;border-radius:6rpx;font-size:14rpx}.corner-label{position:absolute;right:10rpx;bottom:10rpx;padding:5rpx 8rpx;background:rgba(255,255,255,.9);border-radius:7rpx;color:#7f2b00;font-size:16rpx}.section-row{margin:44rpx 2rpx 20rpx}.link{flex:none;color:#a33900;font-size:24rpx;font-weight:600}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx}.feature-card{padding:22rpx 10rpx;background:#fff;border:1rpx solid #ebe7df;border-radius:22rpx;text-align:center;box-shadow:0 8rpx 24rpx rgba(31,41,55,.045)}.feature-card text{display:block}.feature-card>text{margin:12rpx 0 5rpx;font-size:24rpx;font-weight:700}.feature-card .small{color:#7a8290;font-size:18rpx;font-weight:400}.feature-icon{width:62rpx;height:62rpx;line-height:62rpx;margin:auto;border-radius:18rpx;font-weight:800}.orange{background:#ffdbce;color:#a33900}.violet{background:#e3dfff;color:#4e45d5}.green{background:#caffdf;color:#006947}.template-scroll{white-space:nowrap;margin:0 -28rpx;padding:0 28rpx 12rpx;width:auto}.home-template{display:inline-block;position:relative;width:250rpx;height:300rpx;margin-right:16rpx;padding:20rpx;box-sizing:border-box;border-radius:24rpx;overflow:hidden;color:#fff;vertical-align:top}.home-template::after{content:"";position:absolute;left:0;right:0;bottom:0;height:110rpx;background:linear-gradient(transparent,rgba(16,24,36,.72))}.home-template>text{position:absolute;z-index:2;left:20rpx}.home-template>text:not(.small){bottom:40rpx;font-size:25rpx;font-weight:700}.home-template>.small{bottom:16rpx;font-size:18rpx}.warm{background:linear-gradient(145deg,#e0a57a,#75412e)}.clean{background:linear-gradient(145deg,#e8edf3,#40536b)}.sale{background:linear-gradient(145deg,#ffbf4f,#a52f13)}.home-template .mock-product{width:100rpx;height:84rpx;top:39%}.trust{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:30rpx;color:#006947;font-size:21rpx}.trust tex