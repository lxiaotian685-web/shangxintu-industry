.home{padding-top:34rpx}.hero{padding:22rpx 4rpx 10rpx}.eyebrow{display:inline-block;padding:9rpx 16rpx;margin-bottom:18rpx;border-radius:12rpx;background:#ffdbce;color:#8b2e00;font-size:22rpx;font-weight:700}.title text{color:#b53f00}.intro{margin:22rpx 0 34rpx}.showcase{margin-top:30rpx}.showcase-head,.section-row{display:flex;align-items:center;justify-content:space-between}.mini-badge{padding:9rpx 13rpx;border-radius:12rpx;background:#e8fff5;color:#006947;font-size:20rpx}.compare{display:flex;align-items:center;margin-top:24rpx}.photo{height:260rpx;flex:1;position:relative;overflow:hidden;border-radius:20rpx}.raw{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10rpx;background:#e8edf8;color:#667085;font-size:22rpx}.photo-icon{font-size:54rpx}.arrow{width:54rpx;text-align:center;color:#b53f00;font-weight:800}.polished{background:linear-gradient(145deg,#e4b78f,#774432)}.cup-shape,.mock-product{position:absolute;width:80rpx;height:92rpx;left:50%;top:50%;transform:translate(-50%,-40%);border-radius:12rpx 12rpx 30rpx 30rpx;background:#f1dfc8;box-shadow:inset -10rpx -8rpx rgba(100,60,40,.12),0 12rpx 20rpx rgba(50,20,10,.18)}.cup-shape::after,.mock-product::after{content:"";position:absolute;right:-24rpx;top:22rpx;width:34rpx;height:38rpx;border:10rpx solid #ead3b9;border-left:0;border-radius:0 28rpx 28rpx 0}.poster-copy{position:absolute;z-index:2;left:14rpx;top:14rpx;color:#fff}.poster-copy text{display:block}.poster-copy text:first-child{font-size:16rpx;letter-spacing:2rpx}.poster-copy .strong{font-size:22rpx;font-weight:700}.poster-copy .small{margin-top:116rpx;padding:4rpx 8rpx;background:#fff;color:#a33900;border-radius:6rpx}.corner-label{position:absolute;right:10rpx;bottom:10rpx;padding:5rpx 8rpx;background:rgba(255,255,255,.85);border-radius:7rpx;color:#7f2b00;font-size:16rpx}.section-row{margin:44rpx 2rpx 20rpx}.link{color:#a33900;font-size:24rpx;font-weight:600}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx}.feature-card{padding:22rpx 12rpx;background:#fff;border-radius:22rpx;text-align:center;box-shadow:0 8rpx 24rpx rgba(38,49,67,.05)}.feature-card text{display:block}.feature-card>text{margin:12rpx 0 5rpx;font-size:24rpx;font-weight:700}.feature-card .small{color:#7a8290;font-size:18rpx;font-weight:400}.feature-icon{width:62rpx;height:62rpx;line-height:62rpx;margin:auto;border-radius:18rpx;font-weight:800}.orange{background:#ffdbce;color:#a33900}.violet{background:#e3dfff;color:#4e45d5}.green{background:#caffdf;color:#006947}.template-scroll{white-space:nowrap;margin:0 -28rpx;padding:0 28rpx 12rpx;width:auto}.home-template{display:inline-block;position:relative;width:250rpx;height:300rpx;margin-right:16rpx;padding:20rpx;box-sizing:border-box;border-radius:24rpx;overflow:hidden;color:#fff;vertical-align:top}.home-template>text{position:absolute;z-index:2;left:20rpx}.home-template>text:not(.small){bottom:40rpx;font-size:25rpx;font-weight:700}.home-template>.small{bottom:16rpx;font-size:18rpx}.warm{background:linear-gradient(145deg,#d3a074,#75412e)}.clean{background:linear-gradient(145deg,#dbe3ee,#718096)}.sale{background:linear-gradient(145deg,#ef9b78,#a52f13)}.home-template .mock-product{width:92rpx;height:105rpx;top:40%}.trust{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:30rpx;color:#006947;font-size:21rpx}.trust text{padding:9rpx 12rpx;background:#e8fff5;border-radius:12rpx}
