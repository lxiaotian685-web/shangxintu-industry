page{background:#f6f7fa;color:#162235;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;overflow-x:hidden}.page{min-height:100vh;box-sizing:border-box;overflow-x:hidden;padding:28rpx 28rpx calc(230rpx + env(safe-area-inset-bottom));background:linear-gradient(180deg,#fffaf5 0,#f6f7fa 560rpx,#f6f7fa 100%)}.topbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:28rpx}.brand{display:flex;align-items:center;gap:14rpx;font-size:32rpx;font-weight:700}.brand-mark{width:58rpx;height:58rpx;display:flex;align-items:center;justify-content:center;border-radius:16rpx;background:#a33900;color:#fff;font-size:30rpx;box-shadow:0 10rpx 24rpx rgba(163,57,0,.22)}.capsule{padding:12rpx 20rpx;border:1rpx solid #dce2eb;border-radius:999rpx;background:rgba(255,255,255,.82);color:#4e5969;font-size:21rpx}.title{font-size:50rpx;line-height:1.24;font-weight:800;letter-spacing:-1rpx}.page-title{margin:12rpx 0 28rpx}.section-title{font-size:31rpx;font-weight:700}.muted{color:#667085;font-size:25rpx;line-height:1.6}.card{box-sizing:border-box;max-width:100%;background:#fff;border:1rpx solid #ebe7df;border-radius:28rpx;padding:28rpx;box-shadow:0 12rpx 36rpx rgba(31,41,55,.065)}button{box-sizing:border-box;min-width:0;border:0}button::after{border:0}.primary{height:96rpx;line-height:96rpx;border-radius:20rpx;background:#b53f00;color:#fff;font-size:29rpx;font-weight:700;box-shadow:0 12rpx 28rpx rgba(163,57,0,.2)}.primary[disabled]{background:#e9ad91;color:#fff;box-shadow:none}.secondary-btn{height:88rpx;line-height:88rpx;border-radius:20rpx;background:#edf1f6;color:#313b4d;font-size:27rpx;font-weight:600}.field-card{box-sizing:border-box;width:100%;min-width:0;margin-top:22rpx;padding:26rpx;background:#fff;border:1rpx solid #ebe7df;border-radius:24rpx;box-shadow:0 8rpx 28rpx rgba(31,41,55,.045)}.label{display:block;margin-bottom:14rpx;font-size:27rpx;font-weight:700}.required{color:#b53f00}.input{display:block;width:100%;min-width:0;height:88rpx;box-sizing:border-box;padding:0 24rpx;border:2rpx solid #dfe3e9;border-radius:18rpx;background:#fbfcfe;font-size:27rpx}.chips{display:flex;flex-wrap:wrap;gap:14rpx}.chip{padding:15rpx 22rpx;border:2rpx solid transparent;border-radius:16rpx;background:#edf1f6;color:#4c5566;font-size:25rpx}.chip.active{border-color:#b53f00;background:#fff0e9;color:#9a3300;font-weight:700}.notice{box-sizing:border-box;max-width:100%;color:#7f2b00;background:#ffede5;padding:22rpx 24rpx;border:1rpx solid #ffd1bd;border-radius:20rpx;font-size:24rpx;line-height:1.6}.stepper{position:relative;display:flex;justify-content:space-between;margin-bottom:24rpx;padding:26rpx 34rpx 22rpx;background:#fff;border:1rpx solid #ebe7df;border-radius:26rpx;box-shadow:0 8rpx 26rpx rgba(31,41,55,.045)}.stepper::before{content:"";position:absolute;left:92rpx;right:92rpx;top:48rpx;height:4rpx;background:#e1e6ed}.step{position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:10rpx;color:#8a8790;font-size:21rpx}.step-dot{width:44rpx;height:44rpx;line-height:44rpx;text-align:center;border-radius:50%;background:#e1e6ed;color:#5a6070;font-weight:700}.step.done .step-dot,.step.active .step-dot{background:#b53f00;color:#fff}.step.active{color:#a33900;font-weight:700}.bottom-action{position:fixed;z-index:20;left:0;right:0;bottom:0;box-sizing:border-box;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.97);border-top:1rpx solid #e7e9ee;box-shadow:0 -10rpx 32rpx rgba(31,41,55,.07)}.tap-active{opacity:.78;transform:scale(.99)}
